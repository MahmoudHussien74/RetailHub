{
  "name": "client",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:desktop": "ng build --base-href ./",
    "electron:dev": "electron . --dev",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "build": {
    "appId": "com.retailhub.pos",
    "productName": "RetailHub",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/client/browser/**/*",
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../dist/backend",
        "to": "api",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RetailHub POS"
    }
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@lucide/angular": "^1.48.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "autoprefixer": "^10.6.1",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2"
  }
}
